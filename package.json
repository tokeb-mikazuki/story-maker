{
  "name": "city-life-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "studio": "vite --config apps/studio/vite.config.ts",
    "studio:build": "vite build --config apps/studio/vite.config.ts --mode player && vite build --config apps/studio/vite.config.ts && vite build --config apps/studio/vite.config.ts --mode single",
    "studio:preview": "vite preview --config apps/studio/vite.config.ts --port 4173",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^25.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "immer": "^11.1.21",
    "js-yaml": "^5.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
